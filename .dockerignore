# Local build artifacts and state: never ship these, and never let them
# invalidate the build cache.
.git/
.github/
node_modules/
tmp/
Diagrams/
.vscode/

# Generated by the styles stage inside the image, never copied from the host.
# Excluding it is what makes //go:embed web/static/* fail loudly if that stage
# breaks, rather than embedding nothing and serving an unstyled site.
web/static/
